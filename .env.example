# MedGemma RunPod API Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# API Key for authenticating requests (generate a secure random string)
# Example: openssl rand -hex 32
API_KEY=your-secure-api-key-here

# HuggingFace token for accessing gated MedGemma model
# Get your token from: https://huggingface.co/settings/tokens
# You must also accept the model license at: https://huggingface.co/google/medgemma-27b-it
HF_TOKEN=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

# =============================================================================
# MODEL SETTINGS (Optional - defaults are optimized for A6000)
# =============================================================================

# Model ID - use the multimodal version for image support
MODEL_ID=google/medgemma-27b-it

# Quantization: "none", "4bit", or "8bit"
# - none: Full precision (~54GB VRAM, requires A100 80GB)
# - 8bit: 8-bit quantization (~30GB VRAM, works on A6000 48GB)
# - 4bit: 4-bit quantization (~15GB VRAM, works on RTX 3090/4090)
QUANTIZATION=8bit

# Maximum tokens for input (MedGemma supports 128K, we limit for memory)
MAX_INPUT_TOKENS=12000

# Maximum new tokens to generate per request
MAX_OUTPUT_TOKENS=4096
DEFAULT_MAX_NEW_TOKENS=2048

# =============================================================================
# INFERENCE SETTINGS (Optional)
# =============================================================================

# Sampling settings
DO_SAMPLE=true
TEMPERATURE=0.7
TOP_P=0.9
TOP_K=50
REPETITION_PENALTY=1.1

# =============================================================================
# SERVER SETTINGS (Optional)
# =============================================================================

# Host and port (0.0.0.0 required for RunPod)
HOST=0.0.0.0
PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================================================
# PERFORMANCE SETTINGS (Optional)
# =============================================================================

# Enable Flash Attention 2 (requires Ampere+ GPU and flash-attn package)
# Provides 2-4x faster attention computation
ENABLE_FLASH_ATTENTION=true

# Enable warmup generation on startup (compiles CUDA kernels)
# Makes first real request faster, adds ~5-10s to startup
ENABLE_WARMUP=true

# Number of tokens to generate during warmup
WARMUP_TOKENS=10

# =============================================================================
# IMAGE SETTINGS (Optional)
# =============================================================================

# Maximum image dimension (MedGemma uses 896x896)
MAX_IMAGE_SIZE=896

# Maximum images per request
MAX_IMAGES_PER_REQUEST=4

# Maximum upload size in MB
MAX_UPLOAD_SIZE_MB=20
